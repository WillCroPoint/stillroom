# Shell-compatible settings, also read by Docker Compose. Quote paths with spaces.
# Exact URL used in your browser, no trailing slash.
FRAIMIC_PUBLIC_ORIGIN=http://localhost:8080
BIND_ADDRESS=127.0.0.1
PORT=8080
# An absolute path is recommended. Otherwise relative to deploy/docker/.
DATA_DIR=./data
# Use your Linux user's numeric IDs (id -u / id -g).
PUID=1000
PGID=1000
# Set both to update from Git. Empty values intentionally prevent accidental pulls.
GIT_REMOTE=
GIT_BRANCH=

# Optional override; empty uses the bundled icon at FRAIMIC_PUBLIC_ORIGIN/icon.png.
UNRAID_ICON_URL=

# Restart after a Docker daemon restart, even if previously stopped.
# Use unless-stopped to preserve an intentional stop across daemon restarts.
RESTART_POLICY=always

# Optional display name; empty uses the public default.
STUDIO_APP_NAME=""
