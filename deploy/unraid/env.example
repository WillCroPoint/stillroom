# Replace this URL with the exact address used to access your Unraid server.
FRAIMIC_PUBLIC_ORIGIN=http://tower:8080
BIND_ADDRESS=0.0.0.0
PORT=8080
DATA_DIR=/mnt/user/appdata/fraimic-studio
PUID=99
PGID=100
# Your fork/remote and the branch containing the Docker files.
GIT_REMOTE=
GIT_BRANCH=

# Optional override; empty uses the bundled icon at FRAIMIC_PUBLIC_ORIGIN/icon.png.
UNRAID_ICON_URL=

# Restart after a Docker daemon restart, even if previously stopped.
# Use unless-stopped to preserve an intentional stop across daemon restarts.
RESTART_POLICY=always

# Optional display name; empty uses the public default.
STUDIO_APP_NAME=""
